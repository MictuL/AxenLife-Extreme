# Copia este archivo como .env y llena tus llaves. Nunca subas .env al repo.
# No pongas llaves en el código: https://docs.stripe.com/keys-best-practices
# Llaves de prueba: https://dashboard.stripe.com/test/apikeys

# Solo servidor (SIN prefijo VITE_, nunca debe llegar al navegador)
STRIPE_SECRET_KEY=sk_test_...

# Solo si algún día el navegador necesita la llave pública (Vite exige VITE_).
# Checkout alojado por redirección no la necesita.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Dominio del sitio (para success_url / cancel_url). Vite dev = 5173
DOMAIN=http://localhost:5173
